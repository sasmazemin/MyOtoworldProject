<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragment.MyAccountFragment">

    <ImageView
        android:id="@+id/imageView47"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/back_1" />

    <TextView
        android:id="@+id/textView15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_bold"
        android:text="Edit Profile"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageView47" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/editProfilePhoto"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="15dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView15"
        app:shapeAppearanceOverlay="@style/circular"
        app:srcCompat="@drawable/profilephoto" />

    <EditText
        android:id="@+id/profileNameText"
        android:layout_width="328dp"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/edittextshape"
        android:elevation="5dp"
        android:ems="10"
        android:hint="Name"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editProfilePhoto" />

    <EditText
        android:id="@+id/profileEmailText"
        android:layout_width="328dp"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/edittextshape"
        android:elevation="5dp"
        android:ems="10"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="@+id/profileNameText"
        app:layout_constraintStart_toStartOf="@+id/profileNameText"
        app:layout_constraintTop_toBottomOf="@+id/profileNameText" />

    <EditText
        android:id="@+id/profilePhoneNumberText"
        android:layout_width="328dp"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/edittextshape"
        android:elevation="5dp"
        android:ems="10"
        android:hint="Phone Number"
        android:inputType="phone"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="@+id/profileEmailText"
        app:layout_constraintStart_toStartOf="@+id/profileEmailText"
        app:layout_constraintTop_toBottomOf="@+id/profileEmailText" />

    <EditText
        android:id="@+id/profileLocationText"
        android:layout_width="328dp"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/edittextshape"
        android:elevation="5dp"
        android:ems="10"
        android:hint="Location"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="@+id/profilePhoneNumberText"
        app:layout_constraintStart_toStartOf="@+id/profilePhoneNumberText"
        app:layout_constraintTop_toBottomOf="@+id/profilePhoneNumberText" />

 <androidx.appcompat.widget.AppCompatButton
     android:id="@+id/profileSaveChanges"
     android:layout_width="328dp"
     android:layout_height="56dp"
     android:layout_marginTop="20dp"
     android:background="@drawable/maincolorbutton"
     android:fontFamily="@font/roboto_bold"
     android:onClick="signUpClicked"
     android:text="SAVE CHANGES"
     android:textColor="@color/white"
     android:textSize="14dp"
     app:layout_constraintEnd_toEndOf="@+id/profileLocationText"
     app:layout_constraintStart_toStartOf="@+id/profileLocationText"
     app:layout_constraintTop_toBottomOf="@+id/profileLocationText" />

</androidx.constraintlayout.widget.ConstraintLayout>