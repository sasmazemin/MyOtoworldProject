<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.FirmSignUpActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/textView18"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/roboto_bold"
                android:text="UPDATE"
                android:textSize="28sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imageView48"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="16dp"
                android:onClick="selectImage"
                android:scaleType="centerCrop"
                android:src="@drawable/add_image_frame_svgrepo_com" />

            <EditText
                android:id="@+id/firmMailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edittextshape"
                android:hint="Mail"
                android:padding="12dp" />

            <EditText
                android:id="@+id/firmPasswordText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edittextshape"
                android:hint="Password"
                android:padding="12dp"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/firmConfirmPasswordText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edittextshape"
                android:hint="Confirm Password"
                android:padding="12dp"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/firmNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edittextshape"
                android:hint="Firm Name"
                android:padding="12dp" />

            <EditText
                android:id="@+id/firmAdressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edittextshape"
                android:hint="Adress"
                android:padding="12dp" />

            <EditText
                android:id="@+id/firmPhoneText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edittextshape"
                android:hint="Phone Number"
                android:padding="12dp"
                android:inputType="phone" />

            <EditText
                android:id="@+id/firmWorkingHourText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edittextshape"
                android:hint="Working Hours"
                android:padding="12dp" />

            <EditText
                android:id="@+id/firmPriceListText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edittextshape"
                android:hint="Price List"
                android:padding="12dp" />

            <EditText
                android:id="@+id/firmLatitudeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edittextshape"
                android:hint="Latitude"
                android:padding="12dp" />

            <EditText
                android:id="@+id/firmLongitudeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/edittextshape"
                android:hint="Longitude"
                android:padding="12dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/firmSignUpClicked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/maincolorbutton"
                android:fontFamily="@font/roboto_bold"
                android:text="UPDATE"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <!-- Go to Home Page Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/goToHomePage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/maincolorbutton"
                android:fontFamily="@font/roboto_bold"
                android:text="GO TO HOME PAGE"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
